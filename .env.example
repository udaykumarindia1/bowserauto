# ---------------------------------------------------------------------------
# docker-compose environment (copy to .env). Never commit the real file.
# Supplied Compose/.env defaults are for local smoke testing only, not public production.
# See docs/OPERATIONS.md and docs/PROJECT_AUDIT.md for HTTPS, cookie, host, registration,
# and mock-platform requirements.
# For local development without Docker see backend/.env.example instead.
# ---------------------------------------------------------------------------

# development | staging | production  (production enforces secrets + PostgreSQL)
APP_ENV=development
LOG_LEVEL=INFO

# Secrets --------------------------------------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          -> SECRET_KEY
#   cd backend && python -m app.core.security gen-key                      -> ENCRYPTION_KEY
SECRET_KEY=
ENCRYPTION_KEY=

# Database / cache -----------------------------------------------------------
POSTGRES_USER=bowser
POSTGRES_PASSWORD=
POSTGRES_DB=bowserauto

# Web ------------------------------------------------------------------------
WEB_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
# Proxy IP/CIDRs may forward X-Forwarded-For only when explicitly trusted.
TRUSTED_PROXY_IPS=
# Development-only; the mock router is disabled in production.
MOCK_PLATFORM_URL=http://backend:8000/mock-platform/
# Empty by default. In production add only exact browser destinations that require private or HTTP access.
BROWSER_ALLOWED_HOSTS=
# true once you serve HTTPS (cookies get the Secure flag)
COOKIE_SECURE=false
# Close self-service sign-up after the first owner account exists
ALLOW_REGISTRATION=true

# Workers --------------------------------------------------------------------
BROWSER_WORKERS=1
MAX_CONCURRENT_TASKS_PER_WORKER=1
# Open browsers kept alive per browser worker for user sessions (0 = auto: tasks per worker + 2)
MAX_OPEN_SESSIONS_PER_WORKER=0
BROWSER_HEADLESS=true
STREAM_MAX_FPS=8

# Limits ---------------------------------------------------------------------
MAX_TASK_DURATION_SECONDS=21600
MAX_SCHEDULED_WORKFLOWS_PER_ORG=50
MAX_BROWSER_SESSIONS_PER_ORG=10
MAX_UPLOAD_SIZE_MB=50
MAX_REQUEST_BODY_MB=64
MAX_GENERATED_FILE_SIZE_MB=2048
MAX_STORAGE_PER_ORG_MB=51200

# AI planner (optional) -------------------------------------------------------
# none | openai | openai_compatible | openrouter | groq | deepseek | together | fireworks |
# mistral | xai | gemini | ollama | anthropic
# Organisations can override this in Settings → Organisation & AI.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90
# Include page screenshots in agent prompts to vision-capable models (set false for text-only AI).
AGENT_USE_VISION=true
# Production: exact internal hostnames that are trusted for private/plain-HTTP model endpoints.
# Example for an Ollama service on the same Docker network: LLM_ALLOWED_HOSTS=ollama
LLM_ALLOWED_HOSTS=

# Notifications (optional) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook (Slack, WhatsApp Business gateways, n8n, …)
NOTIFICATION_WEBHOOK_URL=
