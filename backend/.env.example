# ---------------------------------------------------------------------------
# BowserAuto backend configuration (copy to backend/.env for local development)
#
# Every value can also be provided as a real environment variable (recommended in
# staging/production). Never commit real secrets.
# ---------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# Secrets ------------------------------------------------------------------
# Production refuses to start with the default dev secret or without ENCRYPTION_KEY.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"        -> SECRET_KEY
#   python -m app.core.security gen-key                                 -> ENCRYPTION_KEY
SECRET_KEY=dev-insecure-secret-key-change-me
#ENCRYPTION_KEY=

# Database -----------------------------------------------------------------
# SQLite is fine for development; use PostgreSQL in staging/production.
DATABASE_URL=sqlite+aiosqlite:///./data/bowserauto.db
#DATABASE_URL=postgresql+asyncpg://bowser:bowser@localhost:5432/bowserauto
AUTO_MIGRATE=true

# Redis (optional). Without it the API runs an embedded worker and an in-memory
# event bus (single process). With it you can run `python -m app.workers.main`
# as separate browser-worker processes.
#REDIS_URL=redis://localhost:6379/0
#EMBEDDED_WORKER=true

# Web ----------------------------------------------------------------------
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#TRUSTED_HOSTS=*
#COOKIE_SECURE=false
#SESSION_TTL_HOURS=168
#RATE_LIMIT_PER_MINUTE=300
#ALLOW_REGISTRATION=true

# Storage ------------------------------------------------------------------
DATA_DIR=./data

# Browser ------------------------------------------------------------------
# playwright (default) | fake (in-memory browser used by the automated tests)
BROWSER_BACKEND=playwright
BROWSER_HEADLESS=true
# Path to a Chromium binary when Playwright's managed browser is not installed
# (scripts/fetch_chromium.py downloads a self-contained build for development).
#CHROMIUM_EXECUTABLE_PATH=/home/you/.cache/bowser-chromium/extracted/chromium
#BROWSER_VIEWPORT_WIDTH=1280
#BROWSER_VIEWPORT_HEIGHT=800
#STREAM_MAX_FPS=8
#STREAM_QUALITY=55
# Browser-reachable URL of the built-in mock platform (defaults to the API itself)
#MOCK_PLATFORM_URL=http://127.0.0.1:8000/mock-platform/

# AI planner ---------------------------------------------------------------
# none | openai | openai_compatible | openrouter | groq | deepseek | together | fireworks |
# mistral | xai | gemini | ollama | anthropic
LLM_PROVIDER=none
# Provider-specific model ID (editable from Settings → Organisation & AI)
#LLM_MODEL=gpt-4.1-mini
#LLM_API_KEY=
# Provider API base URL. For Ollama on the same Docker network, use http://ollama:11434
#LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90
# Send browser screenshots to vision-capable models as context (false sends page text only).
AGENT_USE_VISION=true
# In production, exact private/plain-HTTP provider hosts must be explicitly trusted.
# Example: LLM_ALLOWED_HOSTS=ollama,host.docker.internal
#LLM_ALLOWED_HOSTS=

# Limits -------------------------------------------------------------------
#MAX_TASK_DURATION_SECONDS=21600
#MAX_SCHEDULED_WORKFLOWS_PER_ORG=50
#MAX_RETRIES_DEFAULT=3
#MAX_RETRIES_LIMIT=10
#MAX_SCENES_PER_TASK=200
#MAX_CONCURRENT_TASKS_PER_WORKER=1
#MAX_OPEN_SESSIONS_PER_WORKER=0   # 0 = auto (tasks per worker + 2)
#MAX_BROWSER_SESSIONS_PER_ORG=10
#MAX_UPLOAD_SIZE_MB=50
#MAX_GENERATED_FILE_SIZE_MB=2048
#MAX_STORAGE_PER_ORG_MB=51200

# Notifications (optional) -------------------------------------------------
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=bowserauto@example.com
#TELEGRAM_BOT_TOKEN=
#NOTIFICATION_WEBHOOK_URL=
